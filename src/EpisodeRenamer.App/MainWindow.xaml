<Window x:Class="EpisodeRenamer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="مغير أسماء الحلقات الاحترافي ULTRA"
        Height="900" Width="1000"
        MinHeight="700" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{DynamicResource WindowBackground}"
        TextElement.Foreground="{DynamicResource TextBrush}"
        AllowDrop="True"
        DragEnter="Form_DragEnter"
        DragOver="Form_DragOver"
        Drop="Form_DragDrop"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closed="Window_Closed">
    <Window.Resources>
        <Style x:Key="ThemedComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="1"
                                                        Background="{DynamicResource BorderBrush}"
                                                        Width="20" CornerRadius="0,2,2,0">
                                                    <Path x:Name="arrow"
                                                          Data="M 0 0 L 4 4 L 8 0"
                                                          Stroke="{DynamicResource TextBrush}"
                                                          StrokeThickness="1.5"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="contentPresenter"
                                              Content="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SelectionBoxItem}"
                                              ContentTemplate="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SelectionBoxItemTemplate}"
                                              Margin="8,0,26,0"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource InputBackground}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="2">
                                    <ScrollViewer x:Name="dropdownScrollViewer">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemedComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter Margin="10,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatTextBox" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>

        <Style x:Key="PreviewGridRow" TargetType="DataGridRow">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource GridRowForeground}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="سيعدّل">
                    <Setter Property="Background" Value="{DynamicResource StatusModifiedBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="صحيح">
                    <Setter Property="Background" Value="{DynamicResource StatusCorrectBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="متجاهل">
                    <Setter Property="Background" Value="{DynamicResource StatusIgnoredBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header=" مسار المجلد " Padding="8" Margin="0,0,0,8"
                  Foreground="{DynamicResource TextBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="True">
                    <Button x:Name="browseBtn" x:FieldModifier="internal" DockPanel.Dock="Right" Content="استعراض"
                            Background="#3498DB" Width="90" Height="32" Margin="8,0,0,0"
                            Style="{StaticResource ModernButton}" Click="BrowseBtn_Click"/>
                    <TextBox x:Name="pathBox" Height="30"
                             Style="{StaticResource FlatTextBox}"/>
                </DockPanel>
                <CheckBox x:Name="recurseCheck" Grid.Row="1" Content="مجلدات فرعية"
                          Margin="0,8,0,0" FontFamily="Segoe UI" FontSize="13" VerticalAlignment="Center"
                          Foreground="{DynamicResource TextBrush}"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1" Header=" خيارات التسمية " Padding="8" Margin="0,0,0,8"
                  Foreground="{DynamicResource TextBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label x:Name="styleLabel" Grid.Column="0" Content="نمط التسمية:" Margin="6,0"
                           VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="13"
                           Foreground="{DynamicResource TextBrush}"/>
                    <ComboBox x:Name="styleDropdown" Grid.Column="1" Width="280" Height="30"
                              VerticalContentAlignment="Center" FontFamily="Segoe UI" FontSize="13" BorderThickness="1"
                              Foreground="{DynamicResource TextBrush}"
                              Style="{StaticResource ThemedComboBox}"
                              ItemContainerStyle="{StaticResource ThemedComboBoxItem}"
                              SelectionChanged="StyleDropdown_SelectionChanged"/>
                    <Label x:Name="showLabel" Grid.Column="2" Content="اسم المسلسل:" Margin="6,0"
                           VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="13"
                           Foreground="{DynamicResource TextBrush}"/>
                    <TextBox x:Name="showBox" Grid.Column="3" Width="200" Height="30"
                             Margin="4,0" Style="{StaticResource FlatTextBox}"
                             TextChanged="ShowBox_TextChanged"/>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <CheckBox x:Name="cleanTagsCheck" Content="تنظيف علامات المصدر"
                              VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="13"
                              Foreground="{DynamicResource TextBrush}"/>
                    <CheckBox x:Name="subtitleCheck" Content="إعادة تسمية الترجمة"
                              Margin="20,0,0,0" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="13"
                              Foreground="{DynamicResource TextBrush}"/>
                    <Label x:Name="ignoreLabel" Content="استبعاد:" Margin="20,0,0,0"
                           VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="13"
                           Foreground="{DynamicResource TextBrush}"/>
                    <TextBox x:Name="ignoreBox" Width="180" Height="30"
                             ToolTip="أسماء الملفات التي تحتوي على هذه الكلمات سيتم تجاهلها (افصل بفاصلة)"
                             VerticalContentAlignment="Center" FontFamily="Segoe UI" FontSize="13"
                             Style="{StaticResource FlatTextBox}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <Label x:Name="patternLabel" Content="قالب مخصص:" VerticalAlignment="Center"
                           FontFamily="Segoe UI" FontSize="13"
                           Foreground="{DynamicResource TextBrush}"/>
                    <TextBox x:Name="patternBox" Width="320" Height="30"
                             ToolTip="الرموز: {show} {season} {ep} {ep2} {ep3} {epEnd} {epEnd2} {epEnd3} — مثال: {show} - S{season}E{ep3}"
                             VerticalContentAlignment="Center" FontFamily="Segoe UI" FontSize="13"
                             Style="{StaticResource FlatTextBox}"/>
                    <TextBlock Text="الرموز: {show} {season} {ep} {ep2} {ep3} {epEnd} {epEnd2} {epEnd3}" Margin="10,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" FontFamily="Segoe UI" FontSize="12"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,8">
            <Button x:Name="previewBtn" x:FieldModifier="internal" Content="👁 معاينة" Background="#2ECC71"
                    Style="{StaticResource ModernButton}" Click="PreviewBtn_Click"/>
            <Button x:Name="renameBtn" x:FieldModifier="internal" Content="✍ إعادة تسمية" Background="#E74C3C"
                    Margin="10,0,0,0" Style="{StaticResource ModernButton}" Click="RenameBtn_Click"/>
            <Button x:Name="stopBtn" x:FieldModifier="internal" Content="⏹ إيقاف" Background="#E67E22"
                    Margin="10,0,0,0" IsEnabled="False"
                    Style="{StaticResource ModernButton}" Click="StopBtn_Click"/>
            <Button x:Name="undoBtn" x:FieldModifier="internal" Content="↩ تراجع" Background="#95A5A6"
                    Margin="10,0,0,0" Style="{StaticResource ModernButton}" Click="UndoBtn_Click"/>
            <Button x:Name="exportBtn" x:FieldModifier="internal" Content="💾 حفظ التقرير" Background="#34495E"
                    Margin="10,0,0,0" Style="{StaticResource ModernButton}" Click="ExportBtn_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="suggestBtn" x:FieldModifier="internal" Content="اقتراح الاسم" Background="#9B59B6"
                    Width="150" Style="{StaticResource ModernButton}" Click="SuggestBtn_Click"/>
            <Button x:Name="exportSettingsBtn" x:FieldModifier="internal" Content="تصدير الإعدادات"
                    Background="#16A085" Width="150" Margin="10,0,0,0"
                    Style="{StaticResource ModernButton}" Click="ExportSettingsBtn_Click"/>
            <Button x:Name="importSettingsBtn" x:FieldModifier="internal" Content="استيراد الإعدادات"
                    Background="#27AE60" Width="150" Margin="10,0,0,0"
                    Style="{StaticResource ModernButton}" Click="ImportSettingsBtn_Click"/>
            <Button x:Name="themeBtn" x:FieldModifier="internal" Content="☀️" Background="{DynamicResource ThemeButtonBackground}"
                    Foreground="{DynamicResource TextBrush}" Width="46" MinWidth="46" Margin="10,0,0,0"
                    ToolTip="الوضع الليلي / النهاري" Style="{StaticResource ModernButton}" Click="ThemeBtn_Click"/>
        </StackPanel>

        <ProgressBar x:Name="progress" Grid.Row="4" Height="14" Margin="0,4,0,8" Minimum="0" Maximum="100"/>

        <Border x:Name="statusBorder" x:FieldModifier="internal" Grid.Row="5"
                Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="4" Padding="8,4" Margin="0,0,0,8" MinHeight="28">
            <TextBlock x:Name="statusText" x:FieldModifier="internal"
                       FontFamily="Segoe UI" FontSize="13"
                       Foreground="{DynamicResource TextBrush}"
                       TextAlignment="Right" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" Focusable="False"/>
        </Border>

        <DataGrid x:Name="previewGrid" Grid.Row="6"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="{DynamicResource GridBackground}"
                  Foreground="{DynamicResource GridRowForeground}"
                  HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                  RowStyle="{StaticResource PreviewGridRow}"
                  SelectionMode="Single"
                  Margin="0,0,0,8"
                  MouseDoubleClick="PreviewGrid_MouseDoubleClick">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource GridHeaderBackground}"/>
                    <Setter Property="Foreground" Value="{DynamicResource GridHeaderForeground}"/>
                    <Setter Property="FontFamily" Value="Segoe UI"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="6,4"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                        <Expander IsExpanded="True"
                                                  FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"
                                                  Foreground="{DynamicResource GridHeaderForeground}"
                                                  Background="{DynamicResource GridHeaderBackground}">
                                            <Expander.Header>
                                                <TextBlock Text="{Binding Name}" Margin="8,4"/>
                                            </Expander.Header>
                                            <ItemsPresenter/>
                                        </Expander>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </DataGrid.GroupStyle>
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="colStatus" Header="الحالة" Binding="{Binding Status}" Width="Auto" MinWidth="80" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="الاسم الحالي" Binding="{Binding OldName}" Width="Auto" MinWidth="180" MaxWidth="420" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="الاسم الجديد (انقر نقراً مزدوجاً للتعديل)" Binding="{Binding NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="220" MaxWidth="520">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="TextAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>