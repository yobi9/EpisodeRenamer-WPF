<Application x:Class="EpisodeRenamer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EpisodeRenamer.App"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="WindowBackground" Color="#F5F7FA"/>
            <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TextBrush" Color="#1A1A1A"/>
            <SolidColorBrush x:Key="MutedTextBrush" Color="#7F8C8D"/>
            <SolidColorBrush x:Key="BorderBrush" Color="#D0D0D0"/>
            <SolidColorBrush x:Key="GridBackground" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="GridHeaderBackground" Color="#ECF0F1"/>
            <SolidColorBrush x:Key="GridHeaderForeground" Color="#2C3E50"/>
            <SolidColorBrush x:Key="GridRowForeground" Color="#2C3E50"/>
            <SolidColorBrush x:Key="StatusModifiedBrush" Color="#E8F8F5"/>
            <SolidColorBrush x:Key="StatusCorrectBrush" Color="#F4F4F4"/>
            <SolidColorBrush x:Key="StatusIgnoredBrush" Color="#FDECEA"/>
            <SolidColorBrush x:Key="ThemeButtonBackground" Color="#FFFFFF"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
